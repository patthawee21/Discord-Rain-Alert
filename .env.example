DISCORD_TOKEN=lh-BUG_yxjND7zBKxwVJKo_KXEtUZfg5

# Discord Client ID
DISCORD_CLIENT_ID=1058564686720798771

# Channel ID ที่จะส่งแจ้งเตือน (เติมเองหลังจากสร้าง channel)
# RAIN_ALERT_CHANNEL_ID=

# ค่าตั้งค่าการตรวจจับฝน
# ค่า threshold ของสีฝน (0.0-1.0) ยิ่งต่ำยิ่งไวต่อการตรวจจับ
RAIN_DETECTION_THRESHOLD=0.02

# ระยะเวลาเช็คฝนเป็นครั้ง (วินาที)
CHECK_INTERVAL_SECONDS=300

# เวลาที่ต้องตรวจจับฝนต่อเนื่องกี่ครั้งถึงจะส่งแจ้งเตือน
RAIN_CONFIRM_COUNT=1

# จุดหมายที่ต้องการเตือนระยะทางฝน (ค่าเริ่มต้น = เขตลาดกระบัง กทม. แขวงลำปลาทิว)
TARGET_LAT=13.7330169
TARGET_LON=100.776543
# พิกัดสถานีเรดาร์ (ศูนย์กลางภาพ) และรัศมีภาพ ~100 km — ปรับปรับเทียบได้
RADAR_CENTER_LAT=13.7508
RADAR_CENTER_LON=100.7166
RADAR_HALF_RANGE_KM=100
# รัศมีแจ้งเตือน "ฝนกำลังเข้าใกล้" (กม.)
APPROACH_RADIUS_KM=40

# ชื่อจุดหมายที่แสดงในแจ้งเตือน
TARGET_NAME="ลาดกระบัง (LKB)"

# --- TMD NWP Forecast API (พยากรณ์รายชั่วโมง) ---
# สมัครฟรีที่ https://data.tmd.go.th/nwpapi/register แล้วกด "Create New Token"
TMD_API_KEY=
# จำนวนชั่วโมงที่แสดง (สูงสุด 48)
FORECAST_HOURS=6
# ความถี่ส่งพยากรณ์อัตโนมัติ (นาที) = 60 คือทุก 1 ชั่วโมง
FORECAST_INTERVAL_MINUTES=60
